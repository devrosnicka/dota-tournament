APP_NAME="Dota LAN turnaj"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ

APP_MAINTENANCE_DRIVER=file

# Tournament access (SPEC §2.2). Pick your own values.
REGISTRATION_CODE=
ADMIN_PASSWORD=
TV_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Defaults to database/database.sqlite. The production image keeps it on the storage volume.
# DB_DATABASE=/app/storage/database/database.sqlite

# Encrypted cookie session, 30 days.
SESSION_DRIVER=cookie
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
